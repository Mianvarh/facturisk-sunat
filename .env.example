# FactuRisk SUNAT - environment configuration
# Copy this file to ".env" and adjust the values. Never commit real credentials.

# Local MongoDB started with: docker compose up -d  (service "mongodb", port 27017)
MONGODB_URI=mongodb://localhost:27017
# A MongoDB Atlas connection string can be used here instead, e.g.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# Keep credentials out of version control.
MONGODB_DATABASE=facturisk
MONGODB_COLLECTION_SUNAT=proveedores_sunat

# If these variables are empty or missing, the pipeline falls back to the
# local SUNAT backup included in the repository, so no MongoDB instance is
# required for offline runs.
